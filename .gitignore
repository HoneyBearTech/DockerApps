 # .gitignore

# OS X/macOS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Environment variables (Contains sensitive credentials, API keys, etc.)
.secrets/
.env
bin/
certs/
chisel/
compose/
tls/
*.db
*.key
*.pub

# Docker Compose override files (Often used for local-only adjustments)
docker-compose.override.yml
docker-compose.override.yaml

# Local data directories and persistent volumes
# (Prevents syncing giant databases or user uploads to Git)
data/
db_data/
postgres_data/
mysql_data/
mongo_data/
redis_data/
.docker-data/

# Docker build artifacts and caches
.docker/
anon-volumes/

# Log files generated by containers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# ==========================================
# Development Tools & OS Files
# ==========================================

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Operating System files
.DS_Store
Thumbs.db